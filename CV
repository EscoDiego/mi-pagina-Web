<style>
  :root{
    --bg: #0A0403;
    --surface: rgba(255,60,60,0.06);
    --surface-hi: rgba(255,60,60,0.1);
    --border: rgba(255,60,60,0.22);
    --text: #FBEEEC;
    --text-dim: #C79795;
    --text-faint: #8A5654;
    --violet: #FF1A1A;
    --cyan: #FF6A00;
    --pink: #B0001C;
    --grad: linear-gradient(120deg, var(--violet), var(--cyan));
    --grad2: linear-gradient(120deg, var(--pink), var(--violet));
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
