<script>
  (function(){
    var langCard = document.querySelector('.lang-card');
    if (!langCard) return;
    if (!('IntersectionObserver' in window)) { langCard.classList.add('in-view'); return; }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.35 });
    obs.observe(langCard);
  })();

  (function(){
    document.getElementById('cv-download').href = 'data:application/pdf;base64,';
  })();

  (function(){
    var toggleBtn = document.getElementById('lang-toggle');
    var items = document.querySelectorAll('[data-en]');
    var lang = 'es';

    items.forEach(function(el){ el.dataset.es = el.innerHTML; });

    function applyLang(newLang){
      items.forEach(function(el){
        el.innerHTML = newLang === 'en' ? el.dataset.en : el.dataset.es;
      });
      document.documentElement.lang = newLang;
      document.title = newLang === 'en'
        ? 'Diego Cesar Escobar Martinez — Portfolio'
        : 'Diego Cesar Escobar Martinez — Portafolio';
      toggleBtn.textContent = newLang === 'en' ? 'ES' : 'EN';
      toggleBtn.setAttribute('aria-label', newLang === 'en' ? 'Cambiar a español' : 'Switch to English');
      lang = newLang;
    }

    toggleBtn.addEventListener('click', function(){
      applyLang(lang === 'es' ? 'en' : 'es');
    });
  })();
</script>

