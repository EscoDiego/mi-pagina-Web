  @keyframes spin{ to{ transform:rotate(360deg); } }
  .contact-box{
    position:relative; background:#100706; border-radius:26px;
    padding:64px 30px; text-align:center;
  }
  .contact-box h2{
    font-family:'Space Grotesk', sans-serif; font-weight:700;
    font-size:clamp(28px, 5vw, 44px); margin-bottom:16px;
  }
  .contact-box p{ color:var(--text-dim); max-width:48ch; margin:0 auto 32px; font-size:16px; }
  .contact-links{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; }

  footer{ padding:32px 0 40px; text-align:center; }
  footer p{ font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--text-faint); }
</style>
